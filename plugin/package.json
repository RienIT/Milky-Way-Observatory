{
  "name": "@milky-way/observatory-plugin",
  "version": "1.0.0",
  "description": "Drop-in WebGL2 multi-scale universe & Milky Way Observatory React plugin (Earth -> Solar System -> Gaia Stars -> NASA Milky Way -> Sagittarius A* -> Local Group).",
  "private": false,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./canvas": {
      "types": "./src/components/UniverseCanvas.tsx",
      "import": "./src/components/UniverseCanvas.tsx"
    },
    "./assets/*": "./public/*"
  },
  "files": [
    "src",
    "public",
    "README.md",
    "tsconfig.json"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "@heroui/react": "^2.8.0",
    "astronomy-engine": "^2.1.19",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "tailwind-merge": "^3.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "milky-way",
    "threejs",
    "webgl2",
    "astronomy",
    "solar-system",
    "black-hole",
    "react-plugin",
    "observatory"
  ],
  "license": "MIT"
}
